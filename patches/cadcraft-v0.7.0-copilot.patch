+#![cfg(not(target_arch = "wasm32"))]
+use cadcraft_engine::Session;
+use cadcraft_ui_egui::{CadApp, Services, menus};
+use serde_json::json;
+
+#[test]
+fn reopening_from_a_focused_editor_keeps_chat_draft_model_and_drawing() {
+    let mut app = CadApp::new(Session::new(), Services::default());
+    app.run("line", json!({"points":[[0,0],[10,0]]})).unwrap();
+    let drawing = app.session.execute("drawing.inspect", &json!({"entities":true})).unwrap();
+    app.load_prefs(
+        &json!({"copilot":{"model":"gpt-6.1-sol","effort":"xhigh","messages":[{"role":"你","text":"轴承"}],"input":"保留草稿"}}).to_string(),
+    );
+    let before = app.run("ui.copilot.status", json!({})).unwrap();
+    app.run("ui.toggle.copilot", json!({"on":false})).unwrap();
+    let ctx = egui::Context::default();
+    let editor = egui::Id::new("focused_editor");
+    let mut text = "编辑器里的文字".to_string();
+    let mut out = ctx.run_ui(egui::RawInput::default(), |ui| {
+        ui.add(egui::TextEdit::singleline(&mut text).id(editor)).request_focus();
+    });
+    out.textures_delta.clear();
+    let modifiers = egui::Modifiers { ctrl: true, command: true, shift: true, ..Default::default() };
+    let mut out = ctx.run_ui(
+        egui::RawInput {
+            events: vec![egui::Event::Key { key: egui::Key::L, physical_key: None, pressed: true, repeat: false, modifiers }],
+            ..Default::default()
+        },
+        |ui| {
+            ui.add(egui::TextEdit::singleline(&mut text).id(editor));
+            assert!(ui.ctx().egui_wants_keyboard_input());
+            menus::shortcuts(&mut app, ui.ctx());
+        },
+    );
+    out.textures_delta.clear();
+    assert!(app.ui.show_copilot);
+    assert_eq!(app.run("ui.copilot.status", json!({})).unwrap(), before);
+    assert_eq!(app.session.execute("drawing.inspect", &json!({"entities":true})).unwrap(), drawing);
+    assert_eq!(text, "编辑器里的文字");
+    let mut restored = CadApp::new(Session::new(), Services::default());
+    restored.load_prefs(&app.prefs_json());
+    let status = restored.run("ui.copilot.status", json!({})).unwrap();
+    assert!(status["messages"].as_array().unwrap().is_empty(), "a new untitled document must not inherit another document's chat");
+    assert_eq!(status["input"], "");
+    assert_eq!(status["selectedEffort"], "xhigh");
+    assert_eq!(status["serviceRunning"], false);
+}
