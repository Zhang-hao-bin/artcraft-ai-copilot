+#![cfg(not(target_arch = "wasm32"))]
+use cadcraft_doc::Drawing;
+use cadcraft_engine::Session;
+use cadcraft_ui_egui::{CadApp, Services};
+use serde_json::{Value, json};
+
+fn app() -> CadApp {
+    CadApp::new(Session::new(), Services::default())
+}
+fn status(app: &mut CadApp) -> Value {
+    app.run("ui.copilot.status", json!({})).unwrap()
+}
+fn seed(app: &mut CadApp, text: &str) {
+    app.load_prefs(&json!({"copilot":{"model":"chosen-model","effort":"xhigh","messages":[{"role":"你","text":text}],"input":format!("{text}草稿"),"lastSolid":{"kind":text}}}).to_string());
+}
+
+#[test]
+fn new_documents_and_switches_isolate_chat_drafts_threads_and_solid_models() {
+    let mut a = app();
+    seed(&mut a, "图纸A");
+    let first = status(&mut a);
+    a.run("new", json!({})).unwrap();
+    let second = status(&mut a);
+    assert_ne!(first["documentUid"], second["documentUid"]);
+    assert_eq!(second["messages"], json!([]));
+    assert_eq!(second["input"], "");
+    assert!(second["threadId"].is_null() && second["lastSolid"].is_null());
+    assert_eq!(second["selectedModel"], "chosen-model");
+    seed(&mut a, "图纸B");
+    let b = status(&mut a);
+    a.run("document.switch", json!({"index":0})).unwrap();
+    assert_eq!(status(&mut a), first);
+    a.run("document.switch", json!({"index":1})).unwrap();
+    assert_eq!(status(&mut a), b);
+    a.run("ui.copilot.new", json!({})).unwrap();
+    assert_eq!(status(&mut a)["messages"], json!([]));
+    a.run("document.switch", json!({"index":0})).unwrap();
+    assert_eq!(status(&mut a), first);
+}
+
+#[test]
+fn command_line_and_direct_engine_document_switches_also_select_the_right_chat() {
+    let mut a = app();
+    seed(&mut a, "A");
+    let first = status(&mut a);
+    assert!(a.cmdline("new").is_none());
+    assert_eq!(status(&mut a)["messages"], json!([]));
+    a.session.execute("document.switch", &json!({"index":0})).unwrap();
+    assert_eq!(status(&mut a), first);
+}
+
+#[test]
+fn saved_files_restore_only_their_own_history_after_restart_and_close_reopen() {
+    let mut a = app();
+    a.session.state_mut().unwrap().path = Some("/tmp/cadcraft-conversation-A.dxf".into());
+    seed(&mut a, "A");
+    let expected = status(&mut a);
+    a.run("new", json!({})).unwrap();
+    a.session.state_mut().unwrap().path = Some("/tmp/cadcraft-conversation-B.dxf".into());
+    seed(&mut a, "B");
+    let expected_b = status(&mut a);
+    let prefs = a.prefs_json();
+    let mut restarted = CadApp::new(Session::empty(), Services::default());
+    restarted.load_prefs(&prefs);
+    restarted.session.new_drawing(false);
+    assert_eq!(status(&mut restarted)["messages"], json!([]));
+    restarted.session.open_drawing(Drawing::new_metric(), "A", Some("/tmp/cadcraft-conversation-A.dxf".into()));
+    let recovered = status(&mut restarted);
+    assert_eq!(recovered["messages"], expected["messages"]);
+    assert_eq!(recovered["input"], expected["input"]);
+    restarted.session.open_drawing(Drawing::new_metric(), "B", Some("/tmp/cadcraft-conversation-B.dxf".into()));
+    assert_eq!(status(&mut restarted)["messages"], expected_b["messages"]);
+    restarted.run("close", json!({"discard":true})).unwrap();
+    restarted.session.open_drawing(Drawing::new_metric(), "B", Some("/tmp/cadcraft-conversation-B.dxf".into()));
+    assert_eq!(status(&mut restarted)["messages"], expected_b["messages"]);
+}
+
+#[test]
+fn closing_an_earlier_tab_does_not_reassign_chat_by_shifted_tab_index() {
+    let mut a = app();
+    seed(&mut a, "A");
+    a.run("new", json!({})).unwrap();
+    seed(&mut a, "B");
+    let uid = status(&mut a)["documentUid"].clone();
+    a.run("close", json!({"index":0,"discard":true})).unwrap();
+    let remaining = status(&mut a);
+    assert_eq!(remaining["documentUid"], uid);
+    assert_eq!(remaining["messages"][0]["text"], "B");
+    a.run("new", json!({})).unwrap();
+    assert_eq!(status(&mut a)["messages"], json!([]));
+}
+
+#[test]
+fn new_conversation_keeps_saved_history_available_after_close_and_restart() {
+    let mut a = app();
+    a.session.state_mut().unwrap().path = Some("/tmp/cadcraft-reset-chat.dxf".into());
+    seed(&mut a, "删除前的消息");
+    a.run("close", json!({})).unwrap();
+    a.session.open_drawing(Drawing::new_metric(), "A", Some("/tmp/cadcraft-reset-chat.dxf".into()));
+    assert_eq!(status(&mut a)["messages"][0]["text"], "删除前的消息");
+    a.run("ui.copilot.new", json!({})).unwrap();
+    a.run("close", json!({})).unwrap();
+    a.session.open_drawing(Drawing::new_metric(), "A", Some("/tmp/cadcraft-reset-chat.dxf".into()));
+    assert_eq!(status(&mut a)["messages"], json!([]));
+    let prefs = a.prefs_json();
+    let mut restarted = CadApp::new(Session::empty(), Services::default());
+    restarted.load_prefs(&prefs);
+    restarted.session.open_drawing(Drawing::new_metric(), "A", Some("/tmp/cadcraft-reset-chat.dxf".into()));
+    assert_eq!(status(&mut restarted)["messages"], json!([]));
+    assert_eq!(status(&mut restarted)["conversationIndex"], 1);
+    restarted.run("ui.copilot.switch", json!({"index":0})).unwrap();
+    let previous = status(&mut restarted);
+    assert_eq!(previous["messages"][0]["text"], "删除前的消息");
+    assert_eq!(previous["input"], "删除前的消息草稿");
+    assert_eq!(previous["lastSolid"]["kind"], "删除前的消息");
+}
+
+#[test]
+fn save_as_preserves_current_chat_and_separate_paths_for_reopening() {
+    let mut a = app();
+    a.session.state_mut().unwrap().path = Some("/tmp/cadcraft-chat-before.dxf".into());
+    seed(&mut a, "另存之前");
+    let uid = status(&mut a)["documentUid"].clone();
+    a.session.state_mut().unwrap().path = Some("/tmp/cadcraft-chat-after.dxf".into());
+    let after = status(&mut a);
+    assert_eq!(after["documentUid"], uid);
+    assert_eq!(after["messages"][0]["text"], "另存之前");
+    seed(&mut a, "另存之后");
+    let prefs = a.prefs_json();
+    let mut restarted = CadApp::new(Session::empty(), Services::default());
+    restarted.load_prefs(&prefs);
+    restarted.session.open_drawing(Drawing::new_metric(), "前", Some("/tmp/cadcraft-chat-before.dxf".into()));
+    assert_eq!(status(&mut restarted)["messages"][0]["text"], "另存之前");
+    restarted.session.open_drawing(Drawing::new_metric(), "后", Some("/tmp/cadcraft-chat-after.dxf".into()));
+    assert_eq!(status(&mut restarted)["messages"][0]["text"], "另存之后");
+}
+
+#[test]
+fn multiple_conversations_keep_drafts_and_are_isolated_by_document() {
+    let mut a = app();
+    seed(&mut a, "第一段");
+    a.run("ui.copilot.new", json!({})).unwrap();
+    seed(&mut a, "第二段");
+    a.run("ui.copilot.switch", json!({"index":0})).unwrap();
+    assert_eq!(status(&mut a)["input"], "第一段草稿");
+    a.run("ui.copilot.new", json!({})).unwrap();
+    assert_eq!(status(&mut a)["conversationIndex"], 2);
+    assert_eq!(status(&mut a)["conversations"].as_array().unwrap().len(), 3);
+    a.run("new", json!({})).unwrap();
+    assert_eq!(status(&mut a)["conversations"].as_array().unwrap().len(), 1);
+    a.run("document.switch", json!({"index":0})).unwrap();
+    assert_eq!(status(&mut a)["conversationIndex"], 2);
+    a.run("ui.copilot.switch", json!({"index":1})).unwrap();
+    assert_eq!(status(&mut a)["messages"][0]["text"], "第二段");
+    assert_eq!(status(&mut a)["lastSolid"]["kind"], "第二段");
+}
+
+#[test]
+fn invalid_history_selection_and_limit_preserve_existing_chats() {
+    let mut a = app();
+    seed(&mut a, "必须保留");
+    let original = status(&mut a);
+    for index in [json!(-1), json!(999999999999u64), json!("invalid")] {
+        assert!(a.run("ui.copilot.switch", json!({"index":index})).is_err());
+        assert_eq!(status(&mut a), original);
+    }
+    for _ in 1..64 {
+        a.run("ui.copilot.new", json!({})).unwrap();
+    }
+    assert!(a.run("ui.copilot.new", json!({})).is_err());
+    assert_eq!(status(&mut a)["conversations"].as_array().unwrap().len(), 64);
+    a.run("ui.copilot.switch", json!({"index":0})).unwrap();
+    assert_eq!(status(&mut a)["messages"], original["messages"]);
+}
+
+#[test]
+fn sidebar_new_button_and_history_selector_keep_the_old_chat() {
+    fn frame(app: &mut CadApp, ctx: &egui::Context, events: Vec<egui::Event>) -> Vec<(String, egui::Pos2)> {
+        fn texts(shape: &egui::Shape, output: &mut Vec<(String, egui::Pos2)>) {
+            match shape {
+                egui::Shape::Text(text) => output.push((text.galley.job.text.clone(), text.visual_bounding_rect().center())),
+                egui::Shape::Vec(shapes) => {
+                    for shape in shapes {
+                        texts(shape, output);
+                    }
+                }
+                _ => {}
+            }
+        }
+        let mut output = ctx.run_ui(
+            egui::RawInput {
+                screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1600.0, 1000.0))),
+                events,
+                ..Default::default()
+            },
+            |ui| app.ui(ui),
+        );
+        let mut labels = Vec::new();
+        for shape in &output.shapes {
+            texts(&shape.shape, &mut labels);
+        }
+        output.textures_delta.clear();
+        labels
+    }
+    fn click(app: &mut CadApp, ctx: &egui::Context, pos: egui::Pos2) -> Vec<(String, egui::Pos2)> {
+        for pressed in [true, false] {
+            frame(
+                app,
+                ctx,
+                vec![
+                    egui::Event::PointerMoved(pos),
+                    egui::Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed, modifiers: egui::Modifiers::NONE },
+                ],
+            );
+        }
+        frame(app, ctx, vec![])
+    }
+    let mut a = app();
+    a.ui.start_tab = false;
+    a.ui.show_copilot = true;
+    seed(&mut a, "旧聊天");
+    let ctx = egui::Context::default();
+    frame(&mut a, &ctx, vec![]);
+    let labels = frame(&mut a, &ctx, vec![]);
+    let pos = labels.iter().find(|(text, _)| text == "新对话").unwrap().1;
+    click(&mut a, &ctx, pos);
+    assert_eq!(status(&mut a)["conversationIndex"], 1);
+    assert_eq!(status(&mut a)["messages"], json!([]));
+    let labels = frame(&mut a, &ctx, vec![]);
+    let pos = labels.iter().find(|(text, _)| text == "对话 2 · 空白对话").unwrap().1;
+    let labels = click(&mut a, &ctx, pos);
+    let pos = labels.iter().find(|(text, _)| text == "对话 1 · 旧聊天").unwrap().1;
+    click(&mut a, &ctx, pos);
+    assert_eq!(status(&mut a)["conversationIndex"], 0);
+    assert_eq!(status(&mut a)["messages"][0]["text"], "旧聊天");
+    assert_eq!(status(&mut a)["input"], "旧聊天草稿");
+}
