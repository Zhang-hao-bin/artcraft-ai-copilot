+fn solid_backend() -> std::path::PathBuf {
+    std::env::var_os("CADCRAFT_SOLID_BACKEND")
+        .map(std::path::PathBuf::from)
+        .unwrap_or_else(|| std::env::var_os("HOME").map(std::path::PathBuf::from).unwrap_or_default().join(".local/share/cadcraft-solid/backend"))
+}
+
+fn create_solid(args: Value) -> Value {
+    let result = (|| -> Result<Value, String> {
+        let mut child = Command::new(solid_backend())
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+            .map_err(|e| format!("实体后端不可用：{e}"))?;
+        if let Some(mut input) = child.stdin.take()
+            && let Err(e) = writeln!(input, "{args}")
+        {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Err(e.to_string());
+        }
+        let Some(output) = child.stdout.take() else {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Err("实体后端输出不可用".into());
+        };
+        let mut text = String::new();
+        let read = output.take(1_000_000).read_to_string(&mut text);
+        if read.is_err() {
+            let _ = child.kill();
+        }
+        let status = child.wait().map_err(|e| e.to_string())?;
+        read.map_err(|e| e.to_string())?;
+        let result: Value = serde_json::from_str(&text).map_err(|e| format!("实体后端返回错误：{e}"))?;
+        if !status.success() || result.get("ok").and_then(Value::as_bool) != Some(true) {
+            return Err(result.get("error").and_then(Value::as_str).unwrap_or("三维实体生成失败").into());
+        }
+        Ok(result)
+    })();
+    result.unwrap_or_else(|error| json!({"ok":false,"error":error}))
+}
+
+fn effort_label(effort: &str) -> &str {
+    match effort {
+        "none" => "关闭 · none",
+        "minimal" => "极低 · minimal",
+        "low" => "低 · low",
+        "medium" => "中 · medium",
+        "high" => "高 · high",
+        "xhigh" => "超高 · xhigh",
+        "max" => "最高 · max",
+        "ultra" => "极致 · ultra",
+        other => other,
+    }
+}
+
+fn cap_text(s: &str, max: usize) -> String {
+    let mut end = s.len().min(max);
+    while !s.is_char_boundary(end) {
+        end = end.saturating_sub(1);
+    }
+    s.get(..end).unwrap_or("").to_owned()
+}
+
+fn unit_label(code: i64) -> &'static str {
+    match code {
+        1 => "英寸",
+        2 => "英尺",
+        4 => "毫米",
+        5 => "厘米",
+        6 => "米",
+        _ => "图纸单位",
+    }
+}
+
+fn call_control(app: &mut CadApp, ctx: &egui::Context, method: &str, args: Value) -> Value {
+    let (request, _reply) = ControlRequest::new(method, args);
+    match control::handle(app, ctx, &request) {
+        control::Outcome::Done(v) => v,
+        control::Outcome::Screenshot { .. } => json!({"ok":false,"error":"使用 render 读取当前图纸视图"}),
+    }
+}
+
+fn run_tool(app: &mut CadApp, ctx: &egui::Context, name: &str, args: Value) -> Value {
+    match name {
+        "inspect_drawing" => {
+            let mut reply = call_control(app, ctx, "drawing.inspect", args);
+            if let Ok(st) = app.session.state()
+                && let Some(result) = reply.get_mut("result").and_then(Value::as_object_mut)
+            {
+                let units = st.doc.header.i64("INSUNITS", 0);
+                result.insert("insunits".into(), json!(units));
+                result.insert("units".into(), json!(unit_label(units)));
+            }
+            reply
+        }
+        "command_line" => {
+            let mut result = call_control(app, ctx, "cmdline.input", args);
+            if result.pointer("/result/error").is_some()
+                && let Some(o) = result.as_object_mut()
+            {
+                o.insert("ok".into(), json!(false));
+            }
+            result
+        }
+        "execute" => call_control(app, ctx, "engine.execute", args),
+        "render" => call_control(app, ctx, "ui.render", args),
+        "save" => call_control(app, ctx, "app.save", args),
+        "cancel" => call_control(app, ctx, "cmdline.key", json!({"key":"escape"})),
+        "list_commands" => {
+            let filter = args.get("filter").and_then(Value::as_str).unwrap_or("").to_ascii_lowercase();
+            let commands = control::all_commands(app);
+            let result: Vec<Value> = commands
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter(|c| filter.is_empty() || c.to_string().to_ascii_lowercase().contains(&filter))
+                .cloned()
+                .collect();
+            json!({"ok":true,"result":result})
+        }
+        _ => json!({"ok":false,"error":format!("未知 CADCraft 工具：{name}")}),
+    }
+}
+
+fn tool_response(mut output: Value) -> Value {
+    let success = output.get("ok").and_then(Value::as_bool).unwrap_or(false);
+    let png = output.pointer("/result/pngBase64").and_then(Value::as_str).map(str::to_owned);
+    if let Some(result) = output.get_mut("result").and_then(Value::as_object_mut) {
+        result.remove("pngBase64");
+    }
+    let mut items = vec![json!({"type":"inputText","text":output.to_string()})];
+    if let Some(png) = png {
+        items.push(json!({"type":"inputImage","imageUrl":format!("data:image/png;base64,{png}")}));
+    }
+    json!({"success":success,"contentItems":items})
+}
+
+fn tool_specs() -> Value {
+    let tool = |name: &str, description: &str, properties: Value, required: Value| json!({"type":"function","name":name,"description":description,"inputSchema":{"type":"object","properties":properties,"required":required}});
+    json!([{"type":"namespace","name":"cadcraft","description":"操作此 CADCraft 窗口中的活动图纸。","tools":[
+        tool("inspect_drawing","读取实体、几何、尺寸、选择、图层和未保存状态。",json!({"entities":{"type":"boolean"},"limit":{"type":"integer"}}),json!([])),
+        tool("list_commands","查询绘图命令及其精确 JSON 参数说明；必要时先查询再执行。",json!({"filter":{"type":"string"}}),json!([])),
+        tool("command_line","发送 AutoCAD 式命令行文本，如 rectang 0,0 100,60。",json!({"text":{"type":"string"}}),json!(["text"])),
+        tool("execute","以 JSON 参数执行绘图命令；查询 command 的参数后调用。",json!({"command":{"type":"string"},"params":{"type":"object"}}),json!(["command"])),
+        tool("render","获取图纸 PNG 视图；fit=false 是当前视图，fit=true 适合全图检查。",json!({"width":{"type":"integer"},"height":{"type":"integer"},"fit":{"type":"boolean"}}),json!([])),
+        tool("save","保存当前图纸；明确文件路径时传 path。",json!({"path":{"type":"string"}}),json!([])),
+        tool("cancel","取消未完成的绘图命令。",json!({}),json!([])),
+        tool("create_solid","生成真正三维 BRep 实体，并在独立 FreeCAD 中打开。保存 STEP、可编辑 FCStd 和几何验证报告；不修改当前二维图纸。支持轴承 bearing(outerDiameter,innerDiameter,width,balls)、box(length,width,height)、cylinder(radius,height)、sphere(radius)。尺寸使用明确 units。",json!({"kind":{"type":"string","enum":["bearing","box","cylinder","sphere"]},"units":{"type":"string","enum":["mm","inch"]},"dimensions":{"type":"object"}}),json!(["kind","units","dimensions"]))
+    ]}])
+}
