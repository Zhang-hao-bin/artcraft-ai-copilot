+                let (active, conversations) = app.copilot_conversations(self);
+                let mut selected = active;
+                egui::ComboBox::from_id_salt("copilot_conversations")
+                    .width(ui.available_width() - 10.0)
+                    .selected_text(conversations.get(active).and_then(|v| v["title"].as_str()).unwrap_or("空白对话"))
+                    .show_ui(ui, |ui| {
+                        for entry in &conversations {
+                            if let (Some(index), Some(title)) = (entry["index"].as_u64(), entry["title"].as_str()) {
+                                ui.selectable_value(&mut selected, index as usize, title);
