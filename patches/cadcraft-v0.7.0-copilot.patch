diff --git a/crates/ui-egui/src/copilot_documents.rs b/crates/ui-egui/src/copilot_documents.rs
new file mode 100644
index 0000000..47593f5
--- /dev/null
+++ b/crates/ui-egui/src/copilot_documents.rs
@@ -0,0 +1,253 @@
+//! Native conversations belong to document UIDs; persisted history belongs to saved file paths.
+use std::collections::{BTreeMap, BTreeSet};
+
+use serde_json::{Value, json};
+
+use crate::{CadApp, copilot::Copilot};
+
+const MAX_SAVED_CHATS: usize = 64;
+const MAX_SAVED_BYTES: usize = 8 * 1024 * 1024;
+
+#[derive(Default)]
+pub(crate) struct Documents {
+    pub uid: Option<u64>,
+    pub parked: BTreeMap<u64, Copilot>,
+    histories: BTreeMap<u64, History>,
+    paths: BTreeMap<u64, String>,
+    raw_paths: BTreeMap<u64, String>,
+    saved: Vec<(String, Value)>,
+}
+
+const MAX_CONVERSATIONS: usize = 64;
+
+#[derive(Default)]
+struct History {
+    active: usize,
+    inactive: BTreeMap<usize, Copilot>,
+}
+
+impl History {
+    fn preferences(&self, current: &Copilot) -> Value {
+        let conversations: Vec<_> = (0..=self.inactive.len())
+            .map(|index| {
+                let chat = if index == self.active { Some(current) } else { self.inactive.get(&index) };
+                chat.and_then(Copilot::preferences).unwrap_or_else(|| json!({}))
+            })
+            .collect();
+        json!({"active":self.active,"conversations":conversations})
+    }
+
+    fn restore(value: &Value, fresh: &Copilot) -> (Self, Copilot) {
+        let Some(values) = value.get("conversations").and_then(Value::as_array).filter(|v| !v.is_empty()) else {
+            let mut chat = fresh.fresh_document();
+            chat.load_preferences(value);
+            return (Self::default(), chat);
+        };
+        let count = values.len().min(MAX_CONVERSATIONS);
+        let active = value.get("active").and_then(Value::as_u64).and_then(|i| usize::try_from(i).ok()).filter(|i| *i < count).unwrap_or(0);
+        let mut history = Self { active, ..Self::default() };
+        let mut current = fresh.fresh_document();
+        for (index, prefs) in values.iter().take(count).enumerate() {
+            let mut chat = fresh.fresh_document();
+            chat.load_preferences(prefs);
+            if index == active {
+                current = chat;
+            } else {
+                history.inactive.insert(index, chat);
+            }
+        }
+        (history, current)
+    }
+}
+
+fn file_key(path: &str) -> String {
+    std::fs::canonicalize(path).unwrap_or_else(|_| std::path::PathBuf::from(path)).to_string_lossy().into_owned()
+}
+
+fn remember(entries: &mut Vec<(String, Value)>, path: String, value: Value) {
+    entries.retain(|(p, _)| p != &path);
+    entries.push((path, value));
+    while entries.len() > MAX_SAVED_CHATS || entries.iter().map(|(_, v)| v.to_string().len()).sum::<usize>() > MAX_SAVED_BYTES {
+        entries.remove(0);
+    }
+}
+
+impl Documents {
+    pub(crate) fn new(uid: Option<u64>) -> Self {
+        Self { uid, ..Default::default() }
+    }
+}
+
+impl CadApp {
+    fn copilot_history_preferences(&self, uid: u64, current: &Copilot) -> Value {
+        self.copilot_documents.histories.get(&uid).map_or_else(|| History::default().preferences(current), |h| h.preferences(current))
+    }
+
+    pub(crate) fn copilot_conversations(&self, current: &Copilot) -> (usize, Vec<Value>) {
+        let history = self.copilot_documents.uid.and_then(|id| self.copilot_documents.histories.get(&id));
+        let active = history.map_or(0, |h| h.active);
+        let count = history.map_or(1, |h| h.inactive.len() + 1);
+        let entries = (0..count)
+            .map(|index| {
+                let chat = if index == active { Some(current) } else { history.and_then(|h| h.inactive.get(&index)) };
+                let title = chat.map(Copilot::conversation_title).unwrap_or_else(|| "空白对话".into());
+                json!({"index":index,"title":format!("对话 {} · {title}",index+1)})
+            })
+            .collect();
+        (active, entries)
+    }
+
+    pub(crate) fn change_copilot_conversation(&mut self, index: Option<usize>) -> Result<Value, String> {
+        self.sync_copilot_document();
+        let uid = self.copilot_documents.uid.ok_or("请先打开一张图纸")?;
+        let history = self.copilot_documents.histories.entry(uid).or_default();
+        let next = index.unwrap_or(history.inactive.len() + 1);
+        if index.is_none() && next >= MAX_CONVERSATIONS {
+            return Err("当前文件已达到 64 段对话，请使用已有会话".into());
+        }
+        if index.is_some() && next > history.inactive.len() {
+            return Err("对话不存在".into());
+        }
+        if next == history.active {
+            return Ok(json!({"conversationIndex":next}));
+        }
+        let mut current = self.copilot.take().ok_or("Copilot is unavailable")?;
+        if current.busy {
+            current.cancel();
+        }
+        let chat = if index.is_some() { history.inactive.remove(&next) } else { Some(current.fresh_document()) };
+        let Some(chat) = chat else {
+            self.copilot = Some(current);
+            return Err("对话不存在".into());
+        };
+        history.inactive.insert(history.active, current);
+        history.active = next;
+        self.copilot = Some(chat);
+        Ok(json!({"conversationIndex":next}))
+    }
+
+    /// Synchronize before commands/polling/layout, including direct engine document changes.
+    /// A temporarily taken sidebar is owned by the caller; it will synchronize after being restored.
+    pub(crate) fn sync_copilot_document(&mut self) {
+        let Some(current) = self.copilot.as_ref() else { return };
+        let uid = self.session.state().ok().map(|s| s.uid);
+        let raw_paths: BTreeMap<_, _> = self.session.docs.iter().filter_map(|d| d.path.clone().map(|p| (d.uid, p))).collect();
+        let paths: BTreeMap<_, _> = raw_paths
+            .iter()
+            .map(|(uid, path)| {
+                let cached = (self.copilot_documents.raw_paths.get(uid) == Some(path)).then(|| self.copilot_documents.paths.get(uid)).flatten();
+                (*uid, cached.cloned().unwrap_or_else(|| file_key(path)))
+            })
+            .collect();
+        let open: BTreeSet<_> = self.session.docs.iter().map(|d| d.uid).collect();
+        // Preserve the history under its previous filename before Save As changes the path.
+        if let Some(old_uid) = self.copilot_documents.uid
+            && let Some(path) = self.copilot_documents.paths.get(&old_uid)
+            && paths.get(&old_uid) != Some(path)
+        {
+            let prefs = self.copilot_history_preferences(old_uid, current);
+            remember(&mut self.copilot_documents.saved, path.clone(), prefs);
+        }
+        if self.copilot_documents.uid != uid {
+            let fresh = current.fresh_document();
+            if let Some(mut old) = self.copilot.take() {
+                if old.busy {
+                    old.cancel();
+                }
+                if let Some(old_uid) = self.copilot_documents.uid {
+                    if open.contains(&old_uid) {
+                        self.copilot_documents.parked.insert(old_uid, old);
+                    } else if let Some(path) = self.copilot_documents.paths.get(&old_uid) {
+                        let prefs = self.copilot_history_preferences(old_uid, &old);
+                        remember(&mut self.copilot_documents.saved, path.clone(), prefs);
+                        self.copilot_documents.histories.remove(&old_uid);
+                    }
+                }
+            }
+            let parked = uid.and_then(|id| self.copilot_documents.parked.remove(&id));
+            let recovered = parked.is_some();
+            let mut next = parked.unwrap_or(fresh);
+            // Only a saved filename can recover persisted messages. New untitled documents stay blank.
+            if let Some(id) = uid
+                && !recovered
+                && let Some(path) = paths.get(&id)
+                && let Some((_, prefs)) = self.copilot_documents.saved.iter().find(|(p, _)| p == path)
+            {
+                let (history, restored) = History::restore(prefs, &next);
+                self.copilot_documents.histories.insert(id, history);
+                next = restored;
+            }
+            self.copilot = Some(next);
+            self.copilot_documents.uid = uid;
+        }
+        let closed: Vec<_> = self.copilot_documents.parked.keys().filter(|id| !open.contains(id)).copied().collect();
+        for id in closed {
+            if let Some(chat) = self.copilot_documents.parked.remove(&id)
+                && let Some(path) = self.copilot_documents.paths.get(&id)
+            {
+                let prefs = self.copilot_history_preferences(id, &chat);
+                remember(&mut self.copilot_documents.saved, path.clone(), prefs);
+            }
+        }
+        self.copilot_documents.histories.retain(|id, _| open.contains(id));
+        self.copilot_documents.paths = paths;
+        self.copilot_documents.raw_paths = raw_paths;
+    }
+
+    pub(crate) fn copilot_document_preferences(&self) -> Value {
+        let mut saved = self.copilot_documents.saved.clone();
+        for doc in &self.session.docs {
+            let Some(path) = doc.path.as_deref() else { continue };
+            let chat = if self.copilot_documents.uid == Some(doc.uid) { self.copilot.as_ref() } else { self.copilot_documents.parked.get(&doc.uid) };
+            if let Some(chat) = chat {
+                remember(&mut saved, file_key(path), self.copilot_history_preferences(doc.uid, chat));
+            }
+        }
+        json!(saved.into_iter().map(|(path, conversation)| json!({"path":path,"conversation":conversation})).collect::<Vec<_>>())
+    }
+
+    pub(crate) fn load_copilot_documents(&mut self, value: &Value) {
+        self.copilot_documents.saved.clear();
+        if let Some(entries) = value.as_array() {
+            for entry in entries.iter().rev().take(MAX_SAVED_CHATS).rev() {
+                let Some(path) = entry.get("path").and_then(Value::as_str).filter(|p| p.len() <= 4096 && std::path::Path::new(p).is_absolute())
+                else {
+                    continue;
+                };
+                let Some(prefs) = entry.get("conversation") else { continue };
+                let (history, bounded) = History::restore(prefs, &Copilot::default());
+                remember(&mut self.copilot_documents.saved, file_key(path), history.preferences(&bounded));
+            }
+        }
+        if let Some(doc) = self.session.state().ok()
+            && let Some(path) = doc.path.as_deref()
+            && let Some((_, prefs)) = self.copilot_documents.saved.iter().find(|(p, _)| p == &file_key(path))
+            && let Some(chat) = self.copilot.as_mut()
+        {
+            let (history, restored) = History::restore(prefs, chat);
+            self.copilot_documents.histories.insert(doc.uid, history);
+            *chat = restored;
+        }
+    }
+
+    pub(crate) fn poll_copilot_documents(&mut self, ctx: &egui::Context) {
+        self.sync_copilot_document();
+        if let Some(mut chat) = self.copilot.take() {
+            chat.poll(self, ctx);
+            self.copilot = Some(chat);
+        }
+        self.sync_copilot_document();
+        let histories = std::mem::take(&mut self.copilot_documents.histories);
+        for (id, mut history) in histories {
+            for chat in history.inactive.values_mut() {
+                chat.poll(self, ctx);
+            }
+            self.copilot_documents.histories.insert(id, history);
+        }
+        let parked = std::mem::take(&mut self.copilot_documents.parked);
+        for (id, mut chat) in parked {
+            chat.poll(self, ctx);
+            self.copilot_documents.parked.insert(id, chat);
+        }
+    }
+}
