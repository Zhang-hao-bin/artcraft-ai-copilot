+    pub fn show(&mut self, app: &mut PhotocraftApp, ui: &mut egui::Ui) -> Option<(String, Value)> {
+        let mut action = None;
+        let t = Tokens::get(ui.ctx());
+        egui::Panel::right("photocraft_copilot")
+            .default_size(360.0)
+            .min_size(285.0)
+            .max_size(600.0)
+            .resizable(true)
+            .frame(egui::Frame::NONE.fill(t.dock).inner_margin(12.0))
+            .show(ui, |ui| {
+                ui.horizontal(|ui| {
+                    ui.heading("Copilot");
+                    ui.weak("由 Codex 驱动");
+                    if ui.small_button("收起").clicked() {
+                        app.copilot_visible = false;
+                    }
+                });
+                ui.add_space(4.0);
+                ui.add_enabled_ui(app.session.active().is_some(), |ui| self.show_settings(ui));
+                ui.add_space(4.0);
+                if let Some(st) = app.session.active() {
+                    ui.label(egui::RichText::new(&st.doc.name).strong());
+                    ui.weak(format!(
+                        "{} × {} px · {} 位 · {} 个图层{}",
+                        st.doc.size.width,
+                        st.doc.size.height,
+                        st.doc.depth.bits(),
+                        st.doc.layers.len(),
+                        if st.is_dirty() { " · 未保存" } else { "" }
+                    ));
+                } else {
+                    ui.weak("请先新建或打开图像");
+                }
+                let (active, conversations) = app.copilot_conversations(self);
+                let mut selected = active;
+                egui::ComboBox::from_id_salt("copilot_conversations")
+                    .width(ui.available_width() - 10.0)
+                    .selected_text(conversations.get(active).and_then(|v| v["title"].as_str()).unwrap_or("空白对话"))
+                    .show_ui(ui, |ui| {
+                        for entry in &conversations {
+                            if let (Some(index), Some(title)) = (entry["index"].as_u64(), entry["title"].as_str()) {
+                                ui.selectable_value(&mut selected, index as usize, title);
+                            }
+                        }
+                    });
+                if selected != active {
+                    action = Some(("ui.copilot.switch".into(), json!({"index":selected})));
+                }
+                ui.separator();
+                egui::Panel::bottom("copilot_composer").resizable(false).frame(egui::Frame::NONE).show(ui, |ui| {
+                    let settings = self.settings();
+                    let supports_images =
+                        self.models.iter().find(|m| Some(&m.model) == settings.model.as_ref()).is_none_or(|m| m.input_modalities.iter().any(|s| s == "image"));
+                    ui.add_enabled(supports_images, egui::Checkbox::new(&mut self.include_view, "提问时附上当前图像预览"));
+                    let shortcut = take_send_shortcut(ui.ctx());
+                    ui.add(
+                        egui::TextEdit::multiline(&mut self.input)
+                            .id(egui::Id::new("copilot_input"))
+                            .desired_rows(4)
+                            .desired_width(f32::INFINITY)
+                            .hint_text("例如：分析这张图，为标题新建文字图层。"),
+                    );
+                    let mut send = false;
+                    ui.horizontal(|ui| {
+                        send = ui.add_enabled(!self.busy && !self.input.trim().is_empty(), egui::Button::new("发送")).clicked();
+                        if ui.add_enabled(self.busy, egui::Button::new("停止")).clicked() {
+                            self.cancel_jobs(app, &ui.ctx().clone());
+                            self.cancel();
+                        }
+                        if ui.add_enabled(!self.busy, egui::Button::new("新对话")).clicked() {
+                            action = Some(("ui.copilot.new".into(), json!({})));
+                        }
+                        ui.weak("Ctrl+Enter");
+                    });
+                    if (send || shortcut) && !self.busy {
+                        let input = self.input.clone();
+                        if let Err(e) = self.send(app, ui.ctx(), &input) {
+                            self.error(e);
+                        } else {
+                            self.input.clear();
+                        }
+                    }
+                    ui.add_space(4.0);
+                    ui.horizontal(|ui| {
+                        if self.busy {
+                            ui.spinner();
+                        }
+                        ui.small(&self.status);
+                    });
+                });
+                let scroll = self.scroll;
+                self.scroll = false;
+                egui::ScrollArea::vertical().id_salt("copilot_chat").auto_shrink([false, false]).stick_to_bottom(true).show(ui, |ui| {
+                    if self.messages.is_empty() {
+                        ui.add_space(20.0);
+                        ui.label("结合当前图像分析、编辑图层和调整色彩。");
+                        ui.weak("先点上方「启动对话」，再选择模型和思考强度。输入需求后点「发送」。发送时读取当前图像，沿用本机 Codex 登录。");
+                        ui.add_space(12.0);
+                        for prompt in ["分析当前图像与图层", "检查画布尺寸和色彩模式", "新建一个名为修饰的空白图层"] {
+                            if ui.add_enabled(!self.busy, egui::Button::new(prompt)).clicked() {
+                                self.input = prompt.into();
+                            }
+                        }
+                    }
+                    for message in &self.messages {
+                        egui::Frame::NONE.fill(if message.role == "你" { t.field } else { t.dock }).inner_margin(9.0).show(ui, |ui| {
+                            ui.horizontal(|ui| {
+                                ui.label(egui::RichText::new(&message.role).strong());
+                                if ui.small_button("复制").clicked() {
+                                    ui.ctx().copy_text(message.text.clone());
+                                }
+                            });
+                            ui.add(egui::Label::new(&message.text).wrap().selectable(true));
+                        });
+                        ui.add_space(8.0);
+                    }
+                    if scroll {
+                        ui.scroll_to_cursor(Some(egui::Align::BOTTOM));
+                    }
+                });
+            });
+        action
+    }
+}
+
+fn effort_label(effort: &str) -> &str {
+    match effort {
+        "none" => "关闭 · none",
+        "minimal" => "极低 · minimal",
+        "low" => "低 · low",
+        "medium" => "中 · medium",
+        "high" => "高 · high",
+        "xhigh" => "超高 · xhigh",
+        "max" => "最高 · max",
+        "ultra" => "极致 · ultra",
+        other => other,
+    }
+}
+
+fn cap_text(s: &str, max: usize) -> String {
+    let mut end = s.len().min(max);
+    while !s.is_char_boundary(end) {
+        end = end.saturating_sub(1);
+    }
+    s.get(..end).unwrap_or("").to_owned()
+}
+
+fn fresh_id() -> String {
+    static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+    format!(
+        "{}-{}",
+        std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_nanos(),
+        NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
+    )
+}
+
+fn preview(app: &PhotocraftApp) -> Result<Value, String> {
+    use base64::Engine;
+    let st = app.session.active().ok_or("请先打开图像")?;
+    let image = photocraft_compose::thumbnail(&st.doc, 960);
+    let encoder = app.services.encode_png.as_ref().ok_or("PNG 编码器不可用")?;
+    let png = encoder(image.width, image.height, &image.pixels)?;
+    Ok(json!({"base64":base64::engine::general_purpose::STANDARD.encode(png),"mime":"image/png","width":image.width,"height":image.height}))
+}
+
+fn call_control(app: &mut PhotocraftApp, ctx: &egui::Context, method: &str, args: Value) -> Value {
+    let (req, _rx) = ControlRequest::new(method, args);
+    match control::handle(app, ctx, &req) {
+        control::Outcome::Done(v) => v,
+        control::Outcome::AfterJob(job) => json!({"ok":true,"result":{"job":job,"pending":true}}),
+        _ => json!({"ok":false,"error":"该操作需要异步界面输入，请使用图像命令"}),
+    }
+}
+
+fn run_tool(app: &mut PhotocraftApp, ctx: &egui::Context, name: &str, args: Value) -> Value {
+    if !args.is_object() {
+        return json!({"ok":false,"error":"参数必须是 JSON 对象"});
+    }
+    match name {
+        "inspect" => {
+            json!({"ok":true,"result":{"documentUID":app.session.active().map(|s|s.doc.id.0),"document":app.session.active().map(photocraft_engine::inspect::document),"view":app.ui.views.get(app.session.active_index().unwrap_or(0))}})
+        }
+        "list_commands" => {
+            let filter = args.get("filter").and_then(Value::as_str).unwrap_or("").to_lowercase();
+            let (req, _rx) = ControlRequest::new("engine.commands", json!({}));
+            let control::Outcome::Done(mut out) = control::handle(app, ctx, &req) else {
+                return json!({"ok":false,"error":"命令目录不可用"});
+            };
+            if let Some(rows) = out.get_mut("result").and_then(Value::as_array_mut) {
+                rows.retain(|c| filter.is_empty() || c.to_string().to_lowercase().contains(&filter));
+            }
+            out
+        }
+        "execute" => {
+            let Some(id) = args.get("command").and_then(Value::as_str) else {
+                return json!({"ok":false,"error":"缺少 command"});
+            };
+            if id.starts_with("ui.copilot")
+                || id.starts_with("ui.toggle.copilot")
+                || id.starts_with("file.close")
+                || id == "file.new"
+                || id.starts_with("window.document")
+                || id == "window.nextDocument"
+                || id == "window.previousDocument"
+                || id == "file.exit"
+            {
+                return json!({"ok":false,"error":"此工具只能编辑本轮绑定的当前图像，不能切换或关闭文件"});
+            }
+            call_control(app, ctx, "engine.execute", json!({"command":id,"params":args.get("params").cloned().unwrap_or(json!({})),"wait":false}))
+        }
+        "preview" => match preview(app) {
+            Ok(v) => json!({"ok":true,"result":v}),
+            Err(e) => json!({"ok":false,"error":e}),
+        },
+        "save" => call_control(app, ctx, "app.save", json!({"path":args.get("path"),"wait":false})),
+        "jobs_list" => call_control(app, ctx, "jobs.list", json!({})),
+        "jobs_cancel" => call_control(app, ctx, "jobs.cancel", args),
+        _ => json!({"ok":false,"error":"未知 PhotoCraft 工具"}),
+    }
+}
+
+fn tool_response(mut output: Value) -> Value {
+    let success = output.get("ok").and_then(Value::as_bool).unwrap_or(false);
+    let png = output.pointer("/result/base64").and_then(Value::as_str).map(str::to_owned);
+    if let Some(r) = output.get_mut("result").and_then(Value::as_object_mut) {
+        r.remove("base64");
+    }
+    let mut items = vec![json!({"type":"inputText","text":output.to_string()})];
+    if let Some(png) = png {
+        items.push(json!({"type":"inputImage","imageUrl":format!("data:image/png;base64,{png}")}));
+    }
+    json!({"success":success,"contentItems":items})
+}
+
+fn tool_specs() -> Value {
+    let tool = |name: &str, description: &str, properties: Value, required: Value| json!({"type":"function","name":name,"description":description,"inputSchema":{"type":"object","properties":properties,"required":required,"additionalProperties":false}});
+    json!([{"type":"namespace","name":"photocraft","description":"操作本轮绑定的 PhotoCraft 图像。","tools":[
+        tool("inspect","读取当前图像 UID、画布、位深、图层、选择与历史。",json!({}),json!([])),
+        tool("list_commands","查阅真实图像命令及精确参数；修改前先查询。",json!({"filter":{"type":"string"}}),json!([])),
+        tool("execute","运行真实图像编辑命令。长任务返回 job，等待完成后 inspect 验证。",json!({"command":{"type":"string"},"params":{"type":"object","additionalProperties":true}}),json!(["command"])),
+        tool("preview","取得当前图像的合成缩略图，不含其他窗口。",json!({}),json!([])),
+        tool("save","保存到配置的工作目录，path 为相对路径。PSD/pcraft 成为保存路径；PNG 等平面输出为副本。",json!({"path":{"type":"string"}}),json!(["path"])),
+        tool("jobs_list","查询图像后台任务。",json!({}),json!([])),
+        tool("jobs_cancel","取消指定后台任务。",json!({"job":{"type":"integer"}}),json!(["job"]))
+    ]}])
+}
