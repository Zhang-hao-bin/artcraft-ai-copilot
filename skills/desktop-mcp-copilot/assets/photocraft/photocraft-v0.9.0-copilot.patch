+impl PhotocraftApp {
+    pub(crate) fn show_copilot(&mut self, ui: &mut egui::Ui) {
+        self.sync_copilot_document();
+        if !self.copilot_visible && std::env::var_os("PHOTOCRAFT_COPILOT_STATE").is_none() {
+            return;
+        }
+        if !self.copilot_visible {
+            egui::Panel::right("copilot_reopen").exact_size(40.0).show(ui, |ui| {
+                if ui.button("AI").on_hover_text("重开 Codex 对话 · Ctrl+Alt+Shift+F12").clicked() {
+                    self.copilot_visible = true;
+                }
+            });
+            return;
+        }
+        let Some(mut chat) = self.copilot.take() else { return };
+        let action = chat.show(self, ui);
+        self.copilot = Some(chat);
+        if let Some((id, p)) = action {
+            let ctx = ui.ctx().clone();
+            if let Err(e) = self.copilot_command(&ctx, &id, &p) {
+                self.ui.status = e;
+            }
+        }
+    }
+    pub(crate) fn copilot_command(&mut self, ctx: &egui::Context, id: &str, p: &Value) -> Result<Value, String> {
+        if !p.is_object() {
+            return Err("Copilot 参数必须是对象".into());
+        }
+        let allowed: &[&str] = match id {
+            "ui.toggle.copilot" => &["on"],
+            "ui.copilot.configure" => &["input", "includeView", "model", "effort"],
+            "ui.copilot.send" => &["text", "includeView"],
+            "ui.copilot.switch" => &["index"],
+            _ => &[],
+        };
+        if p.as_object().is_some_and(|m| m.keys().any(|k| !allowed.contains(&k.as_str()))) {
+            return Err("Copilot 参数包含未知字段".into());
+        }
+        for key in ["includeView", "on"] {
+            if p.get(key).is_some_and(|v| !v.is_boolean()) {
+                return Err(format!("{key} 必须是布尔值"));
+            }
+        }
+        if p.get("input").is_some_and(|v| v.as_str().is_none_or(|s| s.len() > 32000)) {
+            return Err("input 必须是至多 32000 字节的字符串".into());
+        }
+        self.sync_copilot_document();
+        if id == "ui.copilot.focus" {
+            self.copilot_visible = true;
+            ctx.memory_mut(|m| m.request_focus(egui::Id::new("copilot_input")));
+            return Ok(json!({"focused":true}));
+        }
+        if id == "ui.toggle.copilot" {
+            self.copilot_visible = p.get("on").and_then(Value::as_bool).unwrap_or(!self.copilot_visible);
+            return Ok(json!({"visible":self.copilot_visible}));
+        }
+        if id == "ui.copilot.new" {
+            return self.change_copilot_conversation(None);
+        }
+        if id == "ui.copilot.switch" {
+            let index = p.get("index").and_then(Value::as_u64).and_then(|v| usize::try_from(v).ok()).ok_or("index 必须是非负整数")?;
+            return self.change_copilot_conversation(Some(index));
+        }
+        let Some(mut chat) = self.copilot.take() else { return Err("Copilot 暂时不可用".into()) };
+        let result = match id {
+            "ui.copilot.status" => {
+                let (active, conversations) = self.copilot_conversations(&chat);
+                let mut out = chat.summary();
+                if let Some(v) = out.as_object_mut() {
+                    v.insert("documentUID".into(), json!(self.copilot_documents.uid));
+                    v.insert("visible".into(), json!(self.copilot_visible));
+                    v.insert("conversationIndex".into(), json!(active));
+                    v.insert("conversations".into(), json!(conversations));
+                }
+                Ok(out)
+            }
+            "ui.copilot.connect" => chat.connect(ctx).map(|()| json!({"connecting":true})),
+            "ui.copilot.models.refresh" => chat.refresh_models(ctx).map(|()| json!({"refreshing":true})),
+            "ui.copilot.configure" => {
+                let updated = if p.get("model").is_some() || p.get("effort").is_some() { chat.configure(p) } else { Ok(()) };
+                if updated.is_ok() {
+                    if let Some(input) = p.get("input").and_then(Value::as_str) {
+                        chat.input = input.into();
+                    }
+                    if let Some(include) = p.get("includeView").and_then(Value::as_bool) {
+                        chat.include_view = include;
+                    }
+                }
+                updated.map(|()| json!({"configured":true}))
+            }
+            "ui.copilot.send" => match p.get("text").and_then(Value::as_str) {
+                Some(text) => {
+                    if let Some(v) = p.get("includeView").and_then(Value::as_bool) {
+                        chat.include_view = v;
+                    }
+                    chat.send(self, ctx, text).map(|()| json!({"sending":true}))
+                }
+                None => Err("缺少 text".into()),
+            },
+            "ui.copilot.cancel" => {
+                chat.cancel_jobs(self, ctx);
+                chat.cancel();
+                Ok(json!({"cancelled":true}))
+            }
+            _ => Err("未知 Copilot 命令".into()),
+        };
+        self.copilot = Some(chat);
+        self.sync_copilot_document();
+        self.copilot_persist(true);
+        result
+    }
+}
+
+/// Programmatic sidebar controls are distinct from translated menu entries.
+pub(crate) fn commands() -> Vec<Value> {
+    [("ui.copilot.focus","Focus Copilot Input","{}"),("ui.copilot.status","Copilot Status","{}"),("ui.copilot.connect","Connect Copilot","{}"),("ui.copilot.configure","Configure Copilot","{model?:string|null,effort?:string|null,input?:string,includeView?:bool}"),("ui.copilot.models.refresh","Refresh Models","{}"),("ui.copilot.send","Send Copilot Message","{text:string,includeView?:bool}"),("ui.copilot.cancel","Stop Copilot","{}"),("ui.copilot.new","New Conversation","{}"),("ui.copilot.switch","Switch Conversation","{index:uint}")].into_iter().map(|(id,label,params)|json!({"id":id,"label":label,"params":params,"menu":[],"shortcut":null,"enabled":true,"needsDocument":false,"disabledReason":null})).collect()
+}
+
+fn take_send_shortcut(ctx: &egui::Context) -> bool {
+    // Consume the key before TextEdit handles it. Key events carry their own
+    // modifiers, including when sent by the native control/automation bridge.
+    ctx.memory(|m| m.has_focus(egui::Id::new("copilot_input"))) && ctx.input_mut(|i| i.consume_key(egui::Modifiers::CTRL, egui::Key::Enter))
+}
